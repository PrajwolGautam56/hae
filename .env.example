NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Shared production database used by every company after the unified cutover.
# Leave unset during legacy compatibility; never expose the secret key.
UNIFIED_SUPABASE_URL=https://your-unified-project.supabase.co
UNIFIED_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
UNIFIED_SUPABASE_SECRET_KEY=sb_secret_xxx
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="Hamro Khata <notifications@your-domain.com>"
NEXT_PUBLIC_APP_URL=http://localhost:3010
CLIENT_PORTAL_URL=http://localhost:3010
# Production example: portal.hamroafno.com.np (keep crm.hamroafno.com.np for staff only)
CLIENT_PORTAL_HOST=

# Kritech multi-company control plane. Never expose CONTROL_SUPABASE_SECRET_KEY.
PLATFORM_ROOT_DOMAIN=kritechglobal.com
DEFAULT_TENANT_SLUG=hamro
CONTROL_SUPABASE_URL=https://your-control-project.supabase.co
CONTROL_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
CONTROL_SUPABASE_SECRET_KEY=sb_secret_xxx
PLATFORM_ADMIN_HOST=admin.kritechglobal.com
PLATFORM_ADMIN_URL=http://localhost:3010
PLATFORM_CONTROL_ONLY=false

# Legacy per-company fallback only. Do not add for new shared-database clients.
AG_SUPABASE_URL=
AG_SUPABASE_PUBLISHABLE_KEY=
AG_SUPABASE_SECRET_KEY=
